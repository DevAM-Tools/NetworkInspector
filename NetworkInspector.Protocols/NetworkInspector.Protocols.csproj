<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <Description>Built-in protocol dissectors for NetworkInspector including Ethernet, IPv4, IPv6, TCP, UDP, DNS, DHCPv4, DHCPv6, HTTP/1.x, HTTP/2, TLS, DTLS, WebSocket, ARP, ICMP, ICMPv6, CAN, CAN XL, FlexRay, LIN, SOME/IP, PDU Transport, and more.</Description>
    <PackageTags>network;protocol;dissector;ethernet;ipv4;ipv6;tcp;udp;dns;http;tls;can;someip</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- CS1570/CS1584/CS1658: ZeroAlloc source generator emits invalid XML cref attributes in generated doc comments. -->
    <NoWarn>$(NoWarn);1570;1584;1658</NoWarn>
  </PropertyGroup>

  <!--
    FlexRayLinkTypeFrame is internal. Consumers that reference this assembly (not the
    link-compiled copy) need InternalsVisibleTo to use it from tests:
      - Protocols.Tests — protocol-layer tests (FlexRayProtocol, Signal Message, …)
      - Core.Tests — FlexRayLinkTypeFrameTests (references Protocols for this type only)
    Sources and Exporters do NOT belong here: they link-compile the same .cs file into
    their own assembly and expose it to their test projects via their own InternalsVisibleTo.
    Granting IVT to Sources/Exporters would only matter if they referenced Protocols.dll,
    which they intentionally do not (Core-only dependency; see link-compile comments there).
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="NetworkInspector.Protocols.Tests" />
    <InternalsVisibleTo Include="NetworkInspector.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkInspector.Core\NetworkInspector.Core.csproj" />
    <ProjectReference Include="..\NetworkInspector.Generators\NetworkInspector.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
