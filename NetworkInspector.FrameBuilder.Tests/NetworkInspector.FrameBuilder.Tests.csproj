<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      AllocationTests prove the zero-allocation hot path. Tier-0 code never removes
      boxes, so with tiering the measured loop would run unoptimised code and report
      allocations a steady-state caller never sees. Full JIT optimisation from the
      first call makes that measurement deterministic.
    -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZeroAlloc" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetworkInspector.FrameBuilder\NetworkInspector.FrameBuilder.csproj" />
    <ProjectReference Include="..\NetworkInspector.Values\NetworkInspector.Values.csproj" />
    <ProjectReference Include="..\NetworkInspector.Testing.Tshark\NetworkInspector.Testing.Tshark.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- WithCulture=false: '.cs.txt' must not be treated as Czech satellite resources. -->
    <EmbeddedResource Include="Negative\Snippets\*.cs.txt" WithCulture="false" />
  </ItemGroup>
</Project>
