<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NetworkInspector.FrameBuilder.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="ZeroAlloc" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetworkInspector.FrameBuilder\NetworkInspector.FrameBuilder.csproj" />
    <ProjectReference Include="..\NetworkInspector.Values\NetworkInspector.Values.csproj" />
    <ProjectReference Include="..\NetworkInspector.Testing.Tshark\NetworkInspector.Testing.Tshark.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      WithCulture=false is mandatory: the file extension '.cs.txt' would otherwise
      make MSBuild interpret '.cs' as the Czech culture code and emit the snippets
      into a satellite assembly (cs\*.resources.dll) instead of the main DLL,
      which causes Assembly.GetManifestResourceNames() to return zero entries.
    -->
    <EmbeddedResource Include="Negative\Snippets\*.cs.txt" WithCulture="false" />
  </ItemGroup>
</Project>
