<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <Description>Typed, allocation-free frame-builder library for NetworkInspector. Compose protocol stacks and emit RFC-conformant wire frames with zero heap allocations on the hot path.</Description>
    <PackageTags>network;framebuilder;ethernet;ipv4;ipv6;tcp;udp;websocket;someip;can;pcap</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetworkInspector.FrameBuilder.Tests" />
    <InternalsVisibleTo Include="NetworkInspector.FrameBuilder.NegativeSnippets" />
    <InternalsVisibleTo Include="NetworkInspector.Protocols.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkInspector.Values\NetworkInspector.Values.csproj" />
  </ItemGroup>
</Project>
