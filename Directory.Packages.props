  Central Package Management (CPM) — all NuGet package versions are defined here.
  Do NOT specify Version attributes in individual .csproj files.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageVersion Include="ZeroAlloc" Version="0.2.0" />
  </ItemGroup>
</Project>
