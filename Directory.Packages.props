<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin 1.0.*: 1.1.0 adds CSC009 that Protocols has not absorbed yet. Widen again after Protocols cleanup. -->
    <PackageVersion Include="CSharpStyleChecker" Version="1.0.*" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="TUnit" Version="1.*" />
    <PackageVersion Include="ZeroAlloc" Version="0.6.2" />
    <PackageVersion Include="Parquet.Net" Version="6.1.0" />
    <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.5" />
  </ItemGroup>
</Project>
