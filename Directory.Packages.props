<!--
  Central Package Management (CPM) — all NuGet package versions are defined here.
  Do NOT specify Version attributes in individual .csproj files.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep Roslyn package references on a stable baseline to avoid analyzer/compiler version mismatch warnings in consumers. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="TUnit" Version="1.45.8" />
    <PackageVersion Include="ZeroAlloc" Version="0.4.0" />
  </ItemGroup>
</Project>
