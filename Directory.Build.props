<Project>
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</RepoRoot>

    <!-- Language & framework -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Analysis -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>10-recommended</AnalysisLevel>
    <!--
      CA1711 — Identifiers should not have incorrect suffix
      https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca1711
      Flags type names ending in reserved BCL suffixes (Stack, Delegate, Collection, …).
      Ignored globally: protocol-stack types (IStack, FrameStack, ParseDelegate, …) use domain
      names aligned with dissector/stack vocabulary; renaming would break API clarity and parity
      with generated protocol code.
    -->
    <!--
      CA1720 — Identifier contains type name
      https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca1720
      Flags identifiers that embed CLR type words (String, Signed, Unsigned, Single, …).
      Ignored globally: field-type and wire-format enums mirror protocol/tshark naming
      (FieldType.String, DispatchKeyKind.String, SignalPdu signedness, PDU transport modes);
      alternate names would diverge from dissector labels and user-facing field names.
    -->
    <NoWarn>$(NoWarn);CA1711;CA1720</NoWarn>

    <!-- Build -->
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- No NativeAOT / trimming in this solution -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>

    <!-- Version & package metadata -->
    <Version>0.5.0</Version>
    <Authors>DevAM</Authors>
    <Company>DevAM</Company>
    <Copyright>Copyright © 2026 DevAM. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/DevAM-Tools/NetworkInspector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DevAM-Tools/NetworkInspector</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- CI / Release deterministic packages -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' or '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' or '$(CI)' == 'true'">
    <PackageOutputPath>$(RepoRoot)artifacts\$(Version)\</PackageOutputPath>
  </PropertyGroup>

  <!-- Test projects -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Exe / test / dev-tool projects do not publish XML docs -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe' or '$(IsTestProject)' == 'true' or '$(IsPackable)' == 'false'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
