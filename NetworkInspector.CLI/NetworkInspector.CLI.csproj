<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ni</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ni</ToolCommandName>
    <PackageId>NetworkInspector.CLI</PackageId>
    <Description>Command-line interface for the Network Inspector stack. Provides ni convert and ni export commands for working with network captures.</Description>
    <PackageTags>network;pcap;pcapng;blf;capture;cli;tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkInspector.CLI.Core\NetworkInspector.CLI.Core.csproj" />
  </ItemGroup>
</Project>
