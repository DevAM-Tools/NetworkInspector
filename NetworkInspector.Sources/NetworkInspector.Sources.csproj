<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Frame source implementations for NetworkInspector. Reads PCAP, PCAPNG, Vector BLF, and Vector ASC capture files with streaming and random-access support.</Description>
    <PackageTags>network;pcap;pcapng;blf;asc;capture;frame-source;packet-capture</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Exposes this assembly's link-compiled internal types (e.g. FlexRayLinkTypeFrame) to tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="NetworkInspector.Sources.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkInspector.Core\NetworkInspector.Core.csproj" />
  </ItemGroup>

  <!--
    FlexRayLinkTypeFrame lives in Protocols but is link-compiled here so Sources stays
    Core-only (no ProjectReference to Protocols → no dependency on the full dissector stack).
    The type is internal: each assembly compiles its own copy, so there is no shared CLR type
    identity across Sources / Protocols / Exporters and no ambiguity when a test project
    references multiple assemblies. Sources.Tests reaches this copy via InternalsVisibleTo above.
  -->
  <ItemGroup>
    <Compile Include="..\NetworkInspector.Protocols\FlexRayLinkTypeFrame.cs" Link="Shared\FlexRay\FlexRayLinkTypeFrame.cs" />
  </ItemGroup>
</Project>
