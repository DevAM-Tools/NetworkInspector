<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NetworkInspector.Core</RootNamespace>
    <Description>High-performance protocol analysis stack for network packet dissection. Provides the core framework for protocol registration, field trees, packet parsing, and cross-packet indexing. Includes a Roslyn source generator for declarative protocol definitions.</Description>
    <PackageTags>network;protocol;packet;analysis;dissection;pcap;pcapng;source-generator</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetworkInspector.Core.Tests" />
    <InternalsVisibleTo Include="NetworkInspector.Protocols" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkInspector.Values\NetworkInspector.Values.csproj" />
  </ItemGroup>

  <!-- Bundle the source generator into the NuGet package so consumers get it automatically -->
  <ItemGroup>
    <ProjectReference Include="..\NetworkInspector.Generators\NetworkInspector.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Pack the generator DLL into the standard Roslyn analyzers folder -->
  <!-- The ProjectReference above ensures the generator is built before packing,
       so no Exists() condition is needed here. -->
  <ItemGroup>
    <None Include="..\NetworkInspector.Generators\bin\$(Configuration)\netstandard2.0\NetworkInspector.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/netstandard2.0"
          Visible="false" />
  </ItemGroup>

  <!-- Include README in the NuGet package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
