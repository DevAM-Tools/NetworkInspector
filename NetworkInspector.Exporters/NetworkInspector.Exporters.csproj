<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Frame and packet exporter implementations for NetworkInspector. Writes captured frames and parsed packets to PCAPNG, BLF, ASC, CSV, JSON, PBF, Text, and Parquet formats.</Description>
    <PackageTags>network;pcapng;blf;asc;csv;json;pbf;parquet;columnar;exporter;packet-export;capture</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exposes this assembly's link-compiled internal types (e.g. FlexRayLinkTypeFrame) to tests. -->
    <InternalsVisibleTo Include="NetworkInspector.Exporters.Tests" />
    <!-- Companion DuckDB package consumes the internal ColumnarPacketBatch / IColumnarBatchSink contract. -->
    <InternalsVisibleTo Include="NetworkInspector.Exporters.DuckDb" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc" />
    <PackageReference Include="Parquet.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkInspector.Core\NetworkInspector.Core.csproj" />
  </ItemGroup>

  <!--
    Shared wire-format constants compiled into this assembly (same pattern as PcapConstants).
    FlexRayLinkTypeFrame: see Sources.csproj for the full rationale (Core-only deps,
    internal per-assembly copy). Exporters.Tests reaches this copy via InternalsVisibleTo above.
  -->
  <ItemGroup>
    <Compile Include="..\NetworkInspector.Sources\Pcapng\Format\PcapConstants.cs" Link="Shared\Pcapng\PcapConstants.cs" />
    <Compile Include="..\NetworkInspector.Sources\Pcapng\Format\PcapPadding.cs" Link="Shared\Pcapng\PcapPadding.cs" />
    <Compile Include="..\NetworkInspector.Sources\Blf\Format\BlfConstants.cs" Link="Shared\Blf\BlfConstants.cs" />
    <Compile Include="..\NetworkInspector.Protocols\FlexRayLinkTypeFrame.cs" Link="Shared\FlexRay\FlexRayLinkTypeFrame.cs" />
  </ItemGroup>
</Project>
