<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NetworkInspector.Exporters</RootNamespace>
    <Description>Frame exporter implementations for NetworkInspector. Writes captured frames and parsed packets to PCAPNG, BLF, CSV, JSON, PBF, and plain-text formats with streaming and memory-efficient output.</Description>
    <PackageTags>network;pcapng;blf;csv;json;pbf;exporter;packet-export;capture</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetworkInspector.Exporters.Tests" />
    <InternalsVisibleTo Include="NetworkInspector.Protocols.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkInspector.Core\NetworkInspector.Core.csproj" />
  </ItemGroup>

  <!-- Shared PCAPNG format files (compiled into this assembly, no Sources dependency) -->
  <ItemGroup>
    <Compile Include="..\NetworkInspector.Sources\Pcapng\Format\PcapConstants.cs" Link="Shared\Pcapng\PcapConstants.cs" />
    <Compile Include="..\NetworkInspector.Sources\Pcapng\Format\PcapPadding.cs" Link="Shared\Pcapng\PcapPadding.cs" />
    <Compile Include="..\NetworkInspector.Sources\Pcapng\Format\Blocks\SectionHeaderBlock.cs" Link="Shared\Pcapng\Blocks\SectionHeaderBlock.cs" />
    <Compile Include="..\NetworkInspector.Sources\Pcapng\Format\Blocks\InterfaceDescriptionBlock.cs" Link="Shared\Pcapng\Blocks\InterfaceDescriptionBlock.cs" />
    <Compile Include="..\NetworkInspector.Sources\Pcapng\Format\Blocks\EnhancedPacketBlock.cs" Link="Shared\Pcapng\Blocks\EnhancedPacketBlock.cs" />
    <Compile Include="..\NetworkInspector.Sources\Pcapng\Format\Blocks\OptionHeader.cs" Link="Shared\Pcapng\Blocks\OptionHeader.cs" />
  </ItemGroup>

  <!-- Shared BLF format files (compiled into this assembly, no Sources dependency) -->
  <ItemGroup>
    <Compile Include="..\NetworkInspector.Sources\Blf\Format\BlfConstants.cs" Link="Shared\Blf\BlfConstants.cs" />
    <Compile Include="..\NetworkInspector.Sources\Blf\Format\BlfTimestamp.cs" Link="Shared\Blf\BlfTimestamp.cs" />
    <Compile Include="..\NetworkInspector.Sources\Blf\Format\Headers\BlfFileHeaderPrefix.cs" Link="Shared\Blf\Headers\BlfFileHeaderPrefix.cs" />
    <Compile Include="..\NetworkInspector.Sources\Blf\Format\Headers\BlfBlockHeader.cs" Link="Shared\Blf\Headers\BlfBlockHeader.cs" />
    <Compile Include="..\NetworkInspector.Sources\Blf\Format\Headers\BlfLogObjectHeaderV1.cs" Link="Shared\Blf\Headers\BlfLogObjectHeaderV1.cs" />
    <Compile Include="..\NetworkInspector.Sources\Blf\Format\Headers\BlfLogObjectHeaderV2.cs" Link="Shared\Blf\Headers\BlfLogObjectHeaderV2.cs" />
    <Compile Include="..\NetworkInspector.Sources\Blf\Format\Headers\BlfLogObjectHeaderV3.cs" Link="Shared\Blf\Headers\BlfLogObjectHeaderV3.cs" />
    <Compile Include="..\NetworkInspector.Sources\Blf\Format\Headers\BlfContainerHeader.cs" Link="Shared\Blf\Headers\BlfContainerHeader.cs" />
    <Compile Include="..\NetworkInspector.Sources\Blf\Format\Headers\BlfDate.cs" Link="Shared\Blf\Headers\BlfDate.cs" />
  </ItemGroup>

  <!-- Include README in the NuGet package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
